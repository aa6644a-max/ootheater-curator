# 영화진흥위원회 오픈API 인증키
# 발급: https://www.kobis.or.kr/kobisopenapi/
KOFIC_API_KEY=your_kofic_api_key_here

# 한국영화데이터베이스 오픈API 인증키
# 발급: https://www.kmdb.or.kr/api/apiMain
KMDB_API_KEY=your_kmdb_api_key_here

# Supabase 프로젝트 URL (https://[project-ref].supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role 키 — 파이프라인(서버) 전용, 절대 클라이언트 노출 금지
SUPABASE_KEY=your_supabase_service_role_key_here

# Supabase anon 키 — dashboard.html 프론트엔드 전용 (RLS 적용)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
